{
  "name": "openclaw-visual-studio",
  "version": "0.1.0",
  "description": "驭爪 (Clawhelm) — OpenClaw 本地控制台",
  "private": true,
  "author": "驭爪 Studio",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:backend": "node scripts/prepare-packaging.mjs --backend-only",
    "download:jre": "node scripts/download-jre.mjs",
    "icons:export": "node scripts/export-app-icon.mjs",
    "prepare:package": "node scripts/prepare-packaging.mjs",
    "clean:out": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-out.ps1",
    "package:win": "node scripts/package-win.mjs",
    "package:win:release": "node scripts/package-win.mjs --publish",
    "package:win:lite": "node scripts/package-win.mjs --lite",
    "package:mac": "npm run prepare:package && node scripts/try-download-jre.mjs && npm run build && electron-builder --mac --config scripts/electron-builder.config.mjs",
    "package:linux": "npm run prepare:package && node scripts/try-download-jre.mjs && npm run build && electron-builder --linux --config scripts/electron-builder.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@vicons/ionicons5": "^0.12.0",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.41.0",
    "@vue-flow/minimap": "^1.5.0",
    "date-fns": "^4.1.0",
    "echarts": "^5.5.0",
    "electron-updater": "^6.8.3",
    "monaco-editor": "^0.52.0",
    "naive-ui": "^2.41.0",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "rcedit": "^5.0.1",
    "sass": "^1.82.0",
    "to-ico": "^1.1.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
